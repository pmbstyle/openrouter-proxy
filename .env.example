OPENROUTER_API_KEY=

# CORS Configuration
# Comma-separated list of allowed origins (e.g., http://localhost:3001,https://example.com)
# Leave empty to allow all origins (not recommended for production)
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000
CORS_CREDENTIALS=true

# Authentication Configuration
# Set to 'true' to enable API key authentication
AUTH_ENABLED=false
# Comma-separated list of valid API keys (e.g., key1,key2,key3)
# Leave empty to allow all requests (public mode)
API_KEYS=